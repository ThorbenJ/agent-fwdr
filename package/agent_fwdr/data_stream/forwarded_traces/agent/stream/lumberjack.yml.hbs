# This data stream exists solely to grant traces-*-* in the agent output API key.
# No downstream client connects here; all lumberjack traffic arrives on the forwarded
# stream's 0.0.0.0:5044 listener, which the pipeline then routes to traces-* indices.
#
# The elastic-otel-collector creates one filebeatreceiver per stream on a lumberjack
# input. A stream with enabled:false causes a fatal "no inputs enabled" crash, so this
# stream must be left enabled. The loopback address (127.0.0.3) is used instead of
# 0.0.0.0 to avoid a port-already-in-use conflict with the forwarded stream and to
# ensure this listener is only reachable from within the agent's own network namespace.
listen_address: "127.0.0.3:5044"
